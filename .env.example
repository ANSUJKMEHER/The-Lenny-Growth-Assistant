# ============================================================================
# The Lenny Growth Assistant — environment template
# Copy to `.env` and fill in values. NEVER commit the real `.env`.
# Every variable has a safe default so a fresh clone runs with zero config.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL). The Docker Compose stack overrides these with the
# internal `db` service; the defaults below work for local non-Docker runs.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny

# ---------------------------------------------------------------------------
# LLM provider selection. One of: ollama | anthropic | openai
# This is the DEFAULT at startup. It can also be switched at runtime via the
# UI or `PUT /api/config` — no code changes required.
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# ---- Ollama (LOCAL — mandatory for the demo; no API key needed) ------------
OLLAMA_BASE_URL=http://localhost:11434
# When the API runs inside Docker, `localhost` is the container, not your host.
# The compose file routes Ollama to the host via the host-gateway alias by
# default. Override only if your host Ollama listens elsewhere:
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# A model that runs comfortably on an 8–16GB machine. qwen2.5:7b is a strong
# tool-calling model at ~7B (better grounding than llama3.1 at the same size):
OLLAMA_MODEL=qwen2.5:7b
# Embedding model used for RAG (pull once with: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
# How long Ollama keeps a model resident in memory after use. "30m" avoids a
# cold reload between requests (keep-alive can be a duration, seconds, or -1).
OLLAMA_KEEP_ALIVE=30m

# ---- Anthropic (CLOUD) ------------------------------------------------------
# Leave blank to disable. Required only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- OpenAI (CLOUD) ---------------------------------------------------------
# Leave blank to disable. Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible endpoint if desired:
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Fallback behavior: if the configured provider is unreachable or unconfigured,
# the app tries, in order: ollama -> anthropic -> openai -> hard error.
# Set to false to disable automatic provider fallback.
# ---------------------------------------------------------------------------
LLM_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Agent runtime
# ---------------------------------------------------------------------------
# Which engine drives the agent loop:
#   auto        (default) use the Anthropic Claude Agent SDK when the Anthropic
#               provider is active AND the SDK + Claude Code CLI are installed;
#               otherwise fall back to the built-in provider-agnostic loop.
#   claude_sdk  require the Claude Agent SDK (errors if unavailable).
#   builtin     always use the built-in loop.
AGENT_RUNTIME=auto
# Optional absolute path to the Claude Code CLI binary used by the Agent SDK
# (only needed if `claude` is not on PATH).
CLAUDE_CLI_PATH=

# ---------------------------------------------------------------------------
# Retrieval / RAG
# ---------------------------------------------------------------------------
# Embedding dimension used to size the chunk-embedding column (nomic-embed-text = 768)
EMBEDDING_DIM=768
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
# How many top chunks feed the agent per search:
RETRIEVAL_TOP_K=6

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of allowed CORS origins:
CORS_ORIGINS=*
LOG_LEVEL=INFO
# Create tables automatically at startup (dev/test). Docker disables this and
# applies Alembic migrations instead:
AUTO_CREATE_TABLES=true

# ---------------------------------------------------------------------------
# Artifact rendering safety. HTML artifacts are sanitized server-side and
# rendered in a sandboxed iframe client-side.
# ---------------------------------------------------------------------------
# Maximum size (bytes) of any single generated artifact:
MAX_ARTIFACT_BYTES=262144
